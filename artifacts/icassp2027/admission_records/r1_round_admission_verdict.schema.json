{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datarsi.r1_round_admission_verdict.schema.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_sha256",
    "baseline_arm",
    "candidate_arm",
    "decision",
    "checks",
    "failure_reasons"
  ],
  "properties": {
    "schema_version": {"const": "datarsi.r1_round_admission_verdict.v1"},
    "rule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_arm": {"const": "R0"},
    "candidate_arm": {"const": "DataRSI+M"},
    "decision": {"enum": ["promote", "rollback", "blocked"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "direction", "comparator", "threshold", "value", "reason"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": ["boolean", "null"]},
          "direction": {"enum": ["higher_is_better", "lower_is_better", "boolean_guard"]},
          "comparator": {"enum": [">=", "<=", "==", "all"]},
          "threshold": {"type": ["number", "boolean", "null"]},
          "value": {"type": ["number", "boolean", "null"]},
          "reason": {"type": "string"}
        }
      }
    },
    "failure_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

